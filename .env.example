# Copy to `.env` and fill with your real Neon project values.
# Runtime (Neon POOLED connection string — used by the app at runtime)
DATABASE_URL="postgresql://user:password@ep-pool-region.example.db.neon.tech/neondb?sslmode=require"

# Migrations only (Neon DIRECT/unpooled connection string; same DB, no -pooler host)
DIRECT_URL="postgresql://user:password@ep-direct-region.example.db.neon.tech/neondb?sslmode=direct"

# Dev UI convenience only
NEXT_PUBLIC_APP_URL="http://localhost:3000"
